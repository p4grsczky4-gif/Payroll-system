<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#5f5ce6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Lønn Demo">
  <title>Lønnssystem Demo</title>
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="apple-touch-icon" href="./icons/apple-touch-icon.png">
  <link rel="icon" href="./icons/icon-192.png">
  <style>

:root{
  --bg:#f6f7fb;--panel:#ffffff;--panel-2:#f0f2fa;--text:#17182b;--muted:#6f7287;
  --line:#e2e5ef;--primary:#5f5ce6;--primary-2:#7c72ff;--primary-soft:#ecebff;
  --success:#16835f;--success-soft:#e7f7f1;--warning:#b96f00;--warning-soft:#fff3df;
  --danger:#c43f51;--danger-soft:#fdecef;--shadow:0 12px 30px rgba(31,34,71,.08);
  --radius:20px;--radius-sm:13px;
}
html[data-theme="dark"]{
  --bg:#11131d;--panel:#191c28;--panel-2:#222637;--text:#f5f6ff;--muted:#a7acc1;
  --line:#303548;--primary:#8c85ff;--primary-2:#6f68e8;--primary-soft:#2c2a52;
  --success:#58c69f;--success-soft:#18382f;--warning:#f0b454;--warning-soft:#3a2d18;
  --danger:#ff8190;--danger-soft:#401f27;--shadow:0 14px 35px rgba(0,0,0,.28);
}
*{box-sizing:border-box}html{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
body{margin:0;min-height:100vh;background:var(--bg)}button,input,select,textarea{font:inherit}
button{cursor:pointer}.mobile-only{display:none!important}
#appShell{display:grid;grid-template-columns:270px 1fr;min-height:100vh}
.sidebar{position:sticky;top:0;height:100vh;padding:22px 16px;display:flex;flex-direction:column;background:linear-gradient(180deg,#242044 0%,#17162c 100%);color:white}
.brand{display:flex;gap:12px;align-items:center;padding:4px 8px 24px}.brand-mark{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#8b85ff,#5f5ce6);font-weight:900;font-size:22px;box-shadow:0 10px 20px rgba(95,92,230,.35)}
.brand strong,.brand span{display:block}.brand span{font-size:12px;color:#b9b6db;margin-top:2px}
#mainNav{display:grid;gap:6px}.nav-item{border:0;background:transparent;color:#c8c6dd;padding:12px 13px;border-radius:13px;text-align:left;display:flex;align-items:center;gap:12px;font-weight:700}
.nav-item span{width:24px;text-align:center;font-size:18px}.nav-item:hover,.nav-item.active{background:rgba(255,255,255,.10);color:#fff}
.sidebar-footer{margin-top:auto;padding:18px 10px 2px;display:grid;gap:3px;color:#d7d4e9}.sidebar-footer small{color:#9995b7}
.main{min-width:0}.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:22px 30px 18px;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(14px)}
.eyebrow{margin:0 0 4px;color:var(--muted);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.09em}.topbar h1{margin:0;font-size:29px;letter-spacing:-.03em}
.topbar-actions{display:flex;gap:10px;align-items:center}.role-switch{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:8px 10px;box-shadow:var(--shadow)}
.role-switch span{font-size:12px;color:var(--muted);font-weight:800}.role-switch select{border:0;background:transparent;color:var(--text);font-weight:800;outline:0}
.icon-btn{width:43px;height:43px;border-radius:14px;border:1px solid var(--line);background:var(--panel);color:var(--text);box-shadow:var(--shadow);display:grid;place-items:center}
.view-root{padding:4px 30px 45px;max-width:1600px;margin:0 auto}.page-actions{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px;flex-wrap:wrap}
.btn{border:0;border-radius:13px;padding:11px 15px;font-weight:800;background:var(--panel-2);color:var(--text);display:inline-flex;gap:8px;align-items:center;justify-content:center}
.btn.primary{background:linear-gradient(135deg,var(--primary),var(--primary-2));color:white}.btn.success{background:var(--success);color:white}.btn.danger{background:var(--danger);color:white}.btn.ghost{background:transparent;border:1px solid var(--line)}
.btn.small{padding:8px 10px;border-radius:10px;font-size:13px}.btn:disabled{opacity:.45;cursor:not-allowed}
.grid{display:grid;gap:18px}.grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}.grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}.grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px;min-width:0}
.stat-card{position:relative;overflow:hidden}.stat-card:after{content:"";position:absolute;width:90px;height:90px;border-radius:50%;right:-30px;top:-30px;background:var(--primary-soft)}
.stat-label{color:var(--muted);font-size:13px;font-weight:800}.stat-value{font-size:30px;font-weight:900;letter-spacing:-.04em;margin-top:8px}.stat-note{color:var(--muted);font-size:12px;margin-top:7px}
.section-title{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:15px}.section-title h2,.section-title h3{margin:0}.section-title small{color:var(--muted)}
.filters{display:flex;gap:10px;flex-wrap:wrap}.search,.field input,.field select,.field textarea,.filters input,.filters select{width:100%;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:12px;padding:11px 12px;outline:0}
.search{min-width:240px}.field input:focus,.field select:focus,.field textarea:focus,.filters input:focus,.filters select:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:15px}table{border-collapse:collapse;width:100%;min-width:760px;background:var(--panel)}
th,td{padding:13px 14px;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--panel-2)}
tr:last-child td{border-bottom:0}.money{text-align:right;font-variant-numeric:tabular-nums}.muted{color:var(--muted)}
.badge{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:999px;font-size:12px;font-weight:800;background:var(--panel-2);color:var(--muted)}
.badge.success{background:var(--success-soft);color:var(--success)}.badge.warning{background:var(--warning-soft);color:var(--warning)}.badge.danger{background:var(--danger-soft);color:var(--danger)}.badge.primary{background:var(--primary-soft);color:var(--primary)}
.list{display:grid;gap:10px}.list-item{display:flex;justify-content:space-between;gap:15px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:13px 14px}.list-item strong{display:block}.list-item small{display:block;color:var(--muted);margin-top:3px}
.progress{height:9px;border-radius:99px;background:var(--panel-2);overflow:hidden}.progress>span{display:block;height:100%;background:linear-gradient(90deg,var(--primary),var(--primary-2));border-radius:99px}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:800;color:var(--muted)}.field textarea{min-height:90px;resize:vertical}
.inline-check{display:flex;align-items:center;gap:8px;font-weight:700}.inline-check input{width:auto}.help{font-size:12px;color:var(--muted);line-height:1.45}
.modal-backdrop{position:fixed;inset:0;z-index:100;background:rgba(8,8,20,.58);display:grid;place-items:center;padding:18px}
.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:var(--panel);border-radius:22px;border:1px solid var(--line);box-shadow:0 30px 80px rgba(0,0,0,.3)}
.modal-header,.modal-footer{padding:18px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line)}.modal-footer{border-top:1px solid var(--line);border-bottom:0;justify-content:flex-end}.modal-body{padding:20px}
.toast-host{position:fixed;right:18px;bottom:18px;z-index:200;display:grid;gap:9px}.toast{background:var(--text);color:var(--panel);padding:12px 15px;border-radius:12px;box-shadow:var(--shadow);font-weight:800;animation:toastIn .18s ease-out}
@keyframes toastIn{from{transform:translateY(8px);opacity:0}}
.empty{padding:38px 20px;text-align:center;color:var(--muted)}.empty .empty-icon{font-size:36px;margin-bottom:8px}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:15px}.segmented{display:flex;background:var(--panel-2);padding:4px;border-radius:12px;gap:3px}.segmented button{border:0;background:transparent;color:var(--muted);font-weight:800;padding:8px 10px;border-radius:9px}.segmented button.active{background:var(--panel);color:var(--text);box-shadow:0 3px 10px rgba(0,0,0,.08)}
.employee-card{display:grid;gap:12px}.employee-head{display:flex;justify-content:space-between;gap:10px}.avatar{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:var(--primary-soft);color:var(--primary);font-weight:900}
.employee-main{display:flex;gap:12px;align-items:center}.employee-meta{display:flex;gap:8px;flex-wrap:wrap}.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mini-kpi{background:var(--panel-2);padding:10px;border-radius:11px}.mini-kpi small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;font-weight:800}.mini-kpi strong{display:block;margin-top:3px}
.timeline{display:grid;gap:12px}.timeline-item{display:grid;grid-template-columns:14px 1fr;gap:12px}.timeline-dot{width:12px;height:12px;border-radius:50%;background:var(--primary);margin-top:4px;box-shadow:0 0 0 4px var(--primary-soft)}
.notice{border-radius:14px;padding:13px 15px;background:var(--primary-soft);color:var(--text);border:1px solid color-mix(in srgb,var(--primary) 25%,var(--line))}
.notice.warning{background:var(--warning-soft);border-color:color-mix(in srgb,var(--warning) 28%,var(--line))}.notice.danger{background:var(--danger-soft);border-color:color-mix(in srgb,var(--danger) 28%,var(--line))}
.plan-card{display:grid;gap:12px;border:1px solid var(--line);border-radius:16px;padding:15px;background:var(--panel)}
.plan-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.plan-head strong{display:block}.plan-head small{display:block;color:var(--muted);margin-top:3px}
.plan-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.plan-stat{background:var(--panel-2);padding:10px;border-radius:11px}.plan-stat small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;font-weight:800}.plan-stat strong{display:block;margin-top:3px}
.payslip{max-width:850px;margin:auto;background:white;color:#17182b;border-radius:16px;padding:30px;box-shadow:var(--shadow)}.payslip-head{display:flex;justify-content:space-between;gap:20px;border-bottom:2px solid #17182b;padding-bottom:16px}.payslip-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}.payslip table{min-width:0}.payslip .totals{margin-left:auto;width:min(370px,100%);display:grid;gap:8px}.total-row{display:flex;justify-content:space-between;padding:7px 0}.total-row.net{font-size:20px;font-weight:900;border-top:2px solid #17182b;padding-top:12px}
.mobile-cards{display:none}.actions{display:flex;gap:7px;flex-wrap:wrap}.right{text-align:right}
@media(max-width:1100px){.grid.cols-4{grid-template-columns:repeat(2,1fr)}.grid.cols-3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){
  #appShell{display:block}.sidebar{position:fixed;z-index:90;left:0;top:0;bottom:0;width:280px;transform:translateX(-105%);transition:.2s}.sidebar.open{transform:translateX(0)}
  .mobile-only{display:grid!important}.topbar{padding:15px 16px}.topbar>div:first-child{display:grid;grid-template-columns:43px 1fr;column-gap:10px}.topbar .eyebrow,.topbar h1{grid-column:2}.topbar .eyebrow{margin-top:-39px}.topbar h1{font-size:24px}
  .role-switch span{display:none}.role-switch select{max-width:145px}.view-root{padding:5px 14px 100px}.grid.cols-4,.grid.cols-3,.grid.cols-2{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.desktop-table{display:none}.mobile-cards{display:grid;gap:12px}.search{min-width:0}
  .payslip{padding:20px 14px}.payslip-grid{grid-template-columns:1fr}.payslip-head{display:grid}.topbar-actions{gap:6px}
}
@media(max-width:480px){.grid.cols-4{grid-template-columns:1fr 1fr}.stat-value{font-size:23px}.card{padding:16px}.role-switch{padding:7px}.role-switch select{max-width:115px;font-size:12px}}
@media print{
  body{background:white}.sidebar,.topbar,.page-actions,.no-print,.toast-host{display:none!important}.main,.view-root{padding:0!important}.card{box-shadow:none;border:0}.payslip{box-shadow:none;padding:0;max-width:none}
}

  </style>
</head>
<body>
  <div id="appShell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">L</div>
        <div>
          <strong>Lønnssystem</strong>
          <span>Demo</span>
        </div>
      </div>

      <nav id="mainNav" aria-label="Hovedmeny">
        <button class="nav-item active" data-view="dashboard"><span>⌂</span>Oversikt</button>
        <button class="nav-item" data-view="employees"><span>♙</span>Ansatte</button>
        <button class="nav-item" data-view="variable"><span>＋</span>Variabel lønn</button>
        <button class="nav-item" data-view="consultant"><span>✓</span>Lønnskonsulent</button>
        <button class="nav-item" data-view="runs"><span>▶</span>Lønnskjøring</button>
        <button class="nav-item" data-view="payslips"><span>▤</span>Lønnsslipper</button>
        <button class="nav-item" data-view="reports"><span>▥</span>Rapporter</button>
        <button class="nav-item" data-view="settings"><span>⚙</span>Oppsett</button>
      </nav>

      <div class="sidebar-footer">
        <small>Lokalt arbeidsverktøy</small>
        <strong>Balazs Bodi</strong>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <button id="mobileMenuBtn" class="icon-btn mobile-only" aria-label="Åpne meny">☰</button>
          <p class="eyebrow" id="viewEyebrow">Lønnssystem Demo</p>
          <h1 id="viewTitle">Oversikt</h1>
        </div>
        <div class="topbar-actions">
          <label class="role-switch">
            <span>Rolle</span>
            <select id="roleSelect">
              <option value="admin">Systemadministrator</option>
              <option value="leader">Leder</option>
              <option value="payroll">Lønnskonsulent</option>
              <option value="employee">Ansatt</option>
            </select>
          </label>
          <button id="themeBtn" class="icon-btn" title="Bytt tema">◐</button>
        </div>
      </header>

      <section id="viewRoot" class="view-root" aria-live="polite"></section>
    </main>
  </div>

  <div id="toastHost" class="toast-host"></div>
  <div id="modalHost"></div>
  <input id="importInput" type="file" accept=".json,application/json" hidden>

  <script>

'use strict';

const DB_NAME = 'payroll-demo-db';
const DB_VERSION = 1;
const STORE_NAME = 'state';
const APP_KEY = 'main';
const nf = new Intl.NumberFormat('nb-NO', { style:'currency', currency:'NOK', maximumFractionDigits:2 });
const df = new Intl.DateTimeFormat('nb-NO');

const titles = {
  dashboard:'Oversikt', employees:'Ansattregister', variable:'Registrer variabel lønn',
  consultant:'Lønnskonsulent', runs:'Lønnskjøring', payslips:'Lønnsslipper',
  reports:'Rapporter', settings:'Oppsett'
};

let state;
let currentView = 'dashboard';
let reportType = 'journal';
let saveTimer;

const $ = (s, root=document) => root.querySelector(s);
const $$ = (s, root=document) => [...root.querySelectorAll(s)];
const uid = (prefix='id') => `${prefix}_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,8)}`;
const esc = (v='') => String(v).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const money = v => nf.format(Number(v)||0);
const dateText = v => v ? df.format(new Date(`${v}T12:00:00`)) : '–';
const ymText = ym => {
  if(!ym) return '–';
  const [y,m] = ym.split('-').map(Number);
  return new Intl.DateTimeFormat('nb-NO',{month:'long',year:'numeric'}).format(new Date(y,m-1,1));
};
const initials = name => name.split(/\s+/).map(p=>p[0]).slice(0,2).join('').toUpperCase();
const pct = v => `${Number(v||0).toLocaleString('nb-NO')} %`;
const today = () => new Date().toISOString().slice(0,10);
const monthNow = () => new Date().toISOString().slice(0,7);
const inMonth = (date, period) => date?.slice(0,7) === period;

function defaultState(){
  return {
    meta:{version:3, createdAt:new Date().toISOString(), company:'Lønnssystem Demo', orgNo:'999 999 999', nextEmployeeNo:1007},
    ui:{theme:'light', role:'admin', selectedEmployeeId:'emp_1001'},
    wageTypes:[
      {id:'wt_evening',code:'2100',name:'Kveldstillegg',mode:'hours',rate:62.00,sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'},
      {id:'wt_night',code:'2110',name:'Nattillegg',mode:'hours',rate:78.00,sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'},
      {id:'wt_weekend',code:'2120',name:'Lørdag-/søndagstillegg',mode:'hours',rate:70.00,sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'},
      {id:'wt_holiday',code:'2130',name:'Helligdagstillegg',mode:'hours',rate:140.00,sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'},
      {id:'wt_ot50',code:'2200',name:'Overtid 50 %',mode:'overtime',multiplier:1.5,sign:1,taxable:true,pension:true,vacation:true,category:'Overtid'},
      {id:'wt_ot100',code:'2210',name:'Overtid 100 %',mode:'overtime',multiplier:2,sign:1,taxable:true,pension:true,vacation:true,category:'Overtid'},
      {id:'wt_extra',code:'2300',name:'Ekstratimer',mode:'hourly',multiplier:1,sign:1,taxable:true,pension:true,vacation:true,category:'Timer'},
      {id:'wt_bonus',code:'2400',name:'Bonus / engangsbeløp',mode:'amount',sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'},
      {id:'wt_expense',code:'3100',name:'Utgiftsrefusjon',mode:'amount',sign:1,taxable:false,pension:false,vacation:false,category:'Refusjon'},
      {id:'wt_salary_loan',code:'3200',name:'Lønnslån utbetaling',mode:'amount',sign:1,taxable:false,pension:false,vacation:false,category:'Lønnslån'},
      {id:'wt_unpaid',code:'5100',name:'Trekk ulønnet fravær',mode:'hours',rate:0,sign:-1,taxable:true,pension:true,vacation:true,category:'Trekk'},
      {id:'wt_salary_loan_installment',code:'6200',name:'Lønnslån avdrag',mode:'amount',sign:-1,taxable:false,pension:false,vacation:false,category:'Trekk'},
      {id:'wt_collection',code:'6210',name:'Inkassotrekk',mode:'amount',sign:-1,taxable:false,pension:false,vacation:false,category:'Trekk'},
      {id:'wt_garnishment',code:'6220',name:'Påleggstrekk',mode:'amount',sign:-1,taxable:false,pension:false,vacation:false,category:'Trekk'},
      {id:'wt_union',code:'6230',name:'Fagforeningstrekk',mode:'amount',sign:-1,taxable:false,pension:false,vacation:false,category:'Trekk'},
      {id:'wt_other_deduction',code:'6290',name:'Annet fast trekk',mode:'amount',sign:-1,taxable:false,pension:false,vacation:false,category:'Trekk'},
      {id:'wt_manual',code:'9000',name:'Manuell korreksjon',mode:'amount',sign:1,taxable:true,pension:true,vacation:true,category:'Korreksjon'}
    ],
    employees:[
      {
        id:'emp_1001',employeeNo:'1001',name:'Nora Hansen',birthDate:'1991-03-18',email:'nora.hansen@demo.no',phone:'900 11 111',
        department:'Helse og omsorg',costCenter:'41010',manager:'Mia Johansen',startDate:'2022-08-01',endDate:'',
        positionTitle:'Helsefagarbeider',employmentType:'Fast',salaryType:'monthly',positionPercent:100,weeklyHours:35.5,annualSalary:518000,
        taxRate:28,pensionRate:2,extraTax:0,vacationRate:12,status:'active',
        fixedItems:[{id:'fi1',name:'Funksjonstillegg',amount:1200,kind:'earning'},{id:'fi2',name:'Fagforeningstrekk',amount:530,kind:'deduction'}],deductionPlans:[]
      },
      {
        id:'emp_1002',employeeNo:'1002',name:'Emil Berg',birthDate:'1988-11-04',email:'emil.berg@demo.no',phone:'900 22 222',
        department:'Oppvekst',costCenter:'52020',manager:'Sofie Lund',startDate:'2020-01-15',endDate:'',
        positionTitle:'Miljøterapeut',employmentType:'Fast',salaryType:'monthly',positionPercent:80,weeklyHours:35.5,annualSalary:602000,
        taxRate:31,pensionRate:2,extraTax:300,vacationRate:12,status:'active',
        fixedItems:[{id:'fi3',name:'Kompetansetillegg',amount:850,kind:'earning'}],deductionPlans:[]
      },
      {
        id:'emp_1003',employeeNo:'1003',name:'Selma Nilsen',birthDate:'1998-07-22',email:'selma.nilsen@demo.no',phone:'900 33 333',
        department:'Helse og omsorg',costCenter:'41020',manager:'Mia Johansen',startDate:'2025-02-01',endDate:'',
        positionTitle:'Assistent',employmentType:'Midlertidig',salaryType:'hourly',positionPercent:20,weeklyHours:35.5,annualSalary:438000,
        taxRate:25,pensionRate:2,extraTax:0,vacationRate:12,status:'active',
        fixedItems:[],deductionPlans:[]
      },
      {
        id:'emp_1004',employeeNo:'1004',name:'Jonas Vik',birthDate:'1979-02-09',email:'jonas.vik@demo.no',phone:'900 44 444',
