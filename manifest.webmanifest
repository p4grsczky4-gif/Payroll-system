function openDb(){
  return new Promise((resolve,reject)=>{
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = () => {
      const db = req.result;
      if(!db.objectStoreNames.contains(STORE_NAME)) db.createObjectStore(STORE_NAME);
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}
async function loadState(){
  try{
    const db = await openDb();
    return await new Promise((resolve,reject)=>{
      const tx = db.transaction(STORE_NAME,'readonly');
      const req = tx.objectStore(STORE_NAME).get(APP_KEY);
      req.onsuccess = () => resolve(req.result || null);
      req.onerror = () => reject(req.error);
    });
  }catch(err){
    console.warn('IndexedDB utilgjengelig, bruker localStorage', err);
    const raw = localStorage.getItem('payroll-demo-state');
    return raw ? JSON.parse(raw) : null;
  }
}
async function persistState(){
  try{
    const db = await openDb();
    await new Promise((resolve,reject)=>{
      const tx = db.transaction(STORE_NAME,'readwrite');
      tx.objectStore(STORE_NAME).put(state, APP_KEY);
      tx.oncomplete = resolve;
      tx.onerror = () => reject(tx.error);
    });
  }catch(err){
    localStorage.setItem('payroll-demo-state', JSON.stringify(state));
  }
}
function queueSave(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(()=>persistState(),250);
}
function audit(text, actor='System'){
  state.audit.unshift({id:uid('audit'),at:new Date().toISOString(),text,actor});
  state.audit = state.audit.slice(0,100);
}
function toast(text){
  const el = document.createElement('div');
  el.className='toast'; el.textContent=text;
  $('#toastHost').appendChild(el);
  setTimeout(()=>el.remove(),2600);
}
function statusBadge(status){
  const map={
    active:['Aktiv','success'],inactive:['Inaktiv','danger'],
    draft:['Utkast','primary'],submitted:['Sendt inn','warning'],returned:['Returnert','danger'],
    rejected:['Avvist','danger'],approved:['Godkjent','success'],included:['Med i kjøring','primary'],
    calculated:['Beregnet','warning'],review:['Til kontroll','warning'],closed:['Avsluttet','success']
  };
  const [label,cls]=map[status]||[status,''];
  return `<span class="badge ${cls}">${esc(label)}</span>`;
}
function employeeById(id){ return state.employees.find(e=>e.id===id); }
function wageTypeById(id){ return state.wageTypes.find(w=>w.id===id); }
function employeeHourly(e){ return Number(e.annualSalary||0)/(Number(e.weeklyHours||37.5)*52); }
function monthlySalary(e){ return e.salaryType==='monthly' ? Number(e.annualSalary||0)*(Number(e.positionPercent||0)/100)/12 : 0; }
function fixedEarnings(e){ return (e.fixedItems||[]).filter(i=>i.kind==='earning').reduce((s,i)=>s+Number(i.amount||0),0); }
function fixedDeductions(e){ return (e.fixedItems||[]).filter(i=>i.kind==='deduction').reduce((s,i)=>s+Number(i.amount||0),0); }
function fixedDeductionCode(item){
  const name=String(item.name||'').toLowerCase();
  if(name.includes('inkasso')) return '6210';
  if(name.includes('pålegg')) return '6220';
  if(name.includes('fagforening')) return '6230';
  if(name.includes('lønnslån')||name.includes('lonnslan')) return '6200';
  return '6100';
}
function periodBounds(period){
  const [y,m]=period.split('-').map(Number);
  const start=`${period}-01`;
  const end=new Date(y,m,0).toISOString().slice(0,10);
  return {start,end};
}
function planDeducted(planId,excludeRunId=''){
  return (state.payslips||[])
    .filter(p=>!excludeRunId||p.runId!==excludeRunId)
    .flatMap(p=>p.lines||[])
    .filter(l=>l.sourcePlanId===planId)
    .reduce((s,l)=>s+Math.abs(Number(l.amount||0)),0);
}
function planRemaining(plan,excludeRunId=''){
  return Math.max(0,Number(plan.totalAmount||0)-planDeducted(plan.id,excludeRunId));
}
function planIsDue(plan,period){
  if(plan.status==='paused') return false;
  const {start,end}=periodBounds(period);
  if(plan.startDate && plan.startDate>end) return false;
  if(plan.endDate && plan.endDate<start) return false;
  return planRemaining(plan)>0;
}
function deductionPlanStatus(plan){
  if(planRemaining(plan)<=0) return ['Fullført','success'];
  if(plan.status==='paused') return ['Pauset','warning'];
  return ['Aktiv','primary'];
}
function deductionPlanBadge(plan){
  const [label,cls]=deductionPlanStatus(plan);
  return `<span class="badge ${cls}">${label}</span>`;
}
function migrateState(){
  const defaults=defaultState();
  state.meta ||= {};
  state.meta.version=3;
  state.ui ||= defaults.ui;
  state.wageTypes ||= [];
  defaults.wageTypes.forEach(w=>{
    if(!state.wageTypes.some(existing=>existing.id===w.id||existing.code===w.code)) state.wageTypes.push({...w});
  });
  state.employees ||= [];
  state.employees.forEach(e=>{
    e.fixedItems ||= [];
    e.deductionPlans ||= [];
  });
  state.variableEntries ||= [];
  state.runs ||= [];
  state.payslips ||= [];
  state.audit ||= [];
}
function entryAmount(entry){
  const e=employeeById(entry.employeeId), wt=wageTypeById(entry.wageTypeId);
  if(!e||!wt) return 0;
  const q=Number(entry.quantity||0), supplied=Number(entry.amount||0);
  if(wt.mode==='amount') return supplied * Number(wt.sign||1);
  if(wt.mode==='hours'){
    const rate = wt.id==='wt_unpaid' ? employeeHourly(e) : Number(entry.rate||wt.rate||0);
    return q*rate*Number(wt.sign||1);
  }
  if(wt.mode==='hourly') return q*employeeHourly(e)*Number(wt.multiplier||1)*Number(wt.sign||1);
  if(wt.mode==='overtime') return q*employeeHourly(e)*Number(wt.multiplier||1)*Number(wt.sign||1);
  return supplied;
}
function runById(id){return state.runs.find(r=>r.id===id)}
function activeRun(){return state.runs.find(r=>r.status!=='closed') || state.runs[0]}

function setView(view){
  currentView=view;
  $$('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.view===view));
  $('#viewTitle').textContent=titles[view]||'Lønnssystem';
  $('.sidebar').classList.remove('open');
  render();
}
function render(){
  const root=$('#viewRoot');
  const renderers={dashboard:renderDashboard,employees:renderEmployees,variable:renderVariable,consultant:renderConsultant,runs:renderRuns,payslips:renderPayslips,reports:renderReports,settings:renderSettings};
  root.innerHTML=(renderers[currentView]||renderDashboard)();
  bindViewEvents();
}

function renderDashboard(){
  const active=state.employees.filter(e=>e.status==='active').length;
  const run=activeRun();
  const pending=state.variableEntries.filter(v=>['submitted','returned'].includes(v.status)).length;
  const approved=state.variableEntries.filter(v=>v.status==='approved' && (!run || inMonth(v.date,run.period))).length;
  const slips=run ? state.payslips.filter(p=>p.runId===run.id) : [];
  const gross=slips.reduce((s,p)=>s+p.gross,0), net=slips.reduce((s,p)=>s+p.net,0);
  const progress = run ? ({draft:20,calculated:50,review:75,closed:100}[run.status]||0):0;
  return `
    <div class="page-actions">
      <div class="notice">Dette er en lokal demo. Alle data lagres kun i nettleseren på denne enheten.</div>
      <button class="btn primary" data-action="quick-run">▶ Beregn aktiv kjøring</button>
    </div>
    <div class="grid cols-4">
      ${stat('Aktive ansatte',active,'Ansattregister')}
      ${stat('Til behandling',pending,'Variable lønnsposter')}
      ${stat('Bruttolønn',money(gross),run?ymText(run.period):'Ingen aktiv kjøring')}
      ${stat('Netto lønn',money(net),slips.length?`${slips.length} lønnsslipper`:'Ikke beregnet')}
    </div>
    <div class="grid cols-2" style="margin-top:18px">
      <div class="card">
        <div class="section-title"><div><h2>Aktuell lønnskjøring</h2><small>${run?esc(run.name):'Ingen kjøring'}</small></div>${run?statusBadge(run.status):''}</div>
        ${run?`
          <div class="progress"><span style="width:${progress}%"></span></div>
          <div class="kpi-row" style="margin-top:15px">
            <div class="mini-kpi"><small>Periode</small><strong>${esc(ymText(run.period))}</strong></div>
            <div class="mini-kpi"><small>Godkjente poster</small><strong>${approved}</strong></div>
            <div class="mini-kpi"><small>Lønnsslipper</small><strong>${slips.length}</strong></div>
          </div>
          <div class="actions" style="margin-top:16px">
            <button class="btn small primary" data-nav="runs">Åpne kjøringen</button>
            <button class="btn small ghost" data-nav="payslips">Se lønnsslipper</button>
          </div>`:`<div class="empty">Opprett en lønnskjøring for å starte.</div>`}
      </div>
      <div class="card">
        <div class="section-title"><div><h2>Arbeidsflyt</h2><small>Siste aktivitet</small></div><button class="btn small ghost" data-nav="consultant">Åpne kø</button></div>
        <div class="timeline">
          ${state.audit.slice(0,5).map(a=>`<div class="timeline-item"><span class="timeline-dot"></span><div><strong>${esc(a.text)}</strong><small>${esc(a.actor)} · ${new Date(a.at).toLocaleString('nb-NO')}</small></div></div>`).join('')}
        </div>
      </div>
    </div>
    <div class="grid cols-3" style="margin-top:18px">
      <div class="card"><div class="section-title"><h3>Registrering</h3></div><p class="muted">Leder registrerer timer, tillegg, refusjoner og trekk.</p><button class="btn primary" data-nav="variable">Registrer variabel lønn</button></div>
      <div class="card"><div class="section-title"><h3>Kontroll</h3></div><p class="muted">Lønnskonsulent godkjenner, returnerer eller avviser poster.</p><button class="btn primary" data-nav="consultant">Åpne kontrollkø</button></div>
      <div class="card"><div class="section-title"><h3>Rapportering</h3></div><p class="muted">Se lønnsjournal, trekk, avdelinger og eksportfiler.</p><button class="btn primary" data-nav="reports">Åpne rapporter</button></div>
    </div>`;
}
function stat(label,value,note){return `<div class="card stat-card"><div class="stat-label">${esc(label)}</div><div class="stat-value">${value}</div><div class="stat-note">${esc(note)}</div></div>`}

function renderEmployees(){
  const cards=state.employees.map(e=>`
    <div class="card employee-card employee-row" data-search="${esc((e.name+' '+e.employeeNo+' '+e.department).toLowerCase())}">
      <div class="employee-head">
        <div class="employee-main"><div class="avatar">${initials(e.name)}</div><div><strong>${esc(e.name)}</strong><small class="muted">#${esc(e.employeeNo)} · ${esc(e.positionTitle)}</small></div></div>
        ${statusBadge(e.status)}
      </div>
      <div class="employee-meta"><span class="badge">${esc(e.department)}</span><span class="badge">${esc(e.positionPercent)} %</span><span class="badge">${esc(e.salaryType==='monthly'?'Månedslønn':'Timelønn')}</span></div>
      <div class="kpi-row">
        <div class="mini-kpi"><small>Årslønn 100 %</small><strong>${money(e.annualSalary)}</strong></div>
        <div class="mini-kpi"><small>Månedslønn</small><strong>${money(monthlySalary(e))}</strong></div>
        <div class="mini-kpi"><small>Timesats</small><strong>${money(employeeHourly(e))}</strong></div>
      </div>
      <div class="actions"><button class="btn small primary" data-edit-employee="${e.id}">Rediger</button><button class="btn small ghost" data-deduction-plans="${e.id}">Lån og trekk${(e.deductionPlans||[]).length?` (${(e.deductionPlans||[]).length})`:''}</button><button class="btn small ghost" data-employee-payslip="${e.id}">Lønnsslipp</button></div>
    </div>`).join('');
  return `
    <div class="page-actions">
      <div class="filters"><input id="employeeSearch" class="search" placeholder="Søk etter navn, nummer eller avdeling"></div>
      <button class="btn primary" data-action="new-employee">＋ Ny ansatt</button>
    </div>
    <div class="desktop-table table-wrap">
      <table><thead><tr><th>Ansatt</th><th>Avdeling</th><th>Stilling</th><th>Omfang</th><th>Årslønn</th><th>Skatt</th><th>Status</th><th></th></tr></thead>
      <tbody>
        ${state.employees.map(e=>`<tr class="employee-row" data-search="${esc((e.name+' '+e.employeeNo+' '+e.department).toLowerCase())}">
          <td><strong>${esc(e.name)}</strong><small class="muted">#${esc(e.employeeNo)}</small></td>
          <td>${esc(e.department)}<small class="muted">${esc(e.costCenter)}</small></td>
          <td>${esc(e.positionTitle)}<small class="muted">${esc(e.employmentType)}</small></td>
          <td>${esc(e.positionPercent)} % · ${esc(e.weeklyHours)} t</td>
          <td class="money">${money(e.annualSalary)}</td><td>${pct(e.taxRate)}</td><td>${statusBadge(e.status)}</td>
          <td><div class="actions"><button class="btn small primary" data-edit-employee="${e.id}">Rediger</button><button class="btn small ghost" data-deduction-plans="${e.id}">Lån og trekk${(e.deductionPlans||[]).length?` (${(e.deductionPlans||[]).length})`:''}</button><button class="btn small ghost" data-employee-payslip="${e.id}">Lønnsslipp</button></div></td>
        </tr>`).join('')}
      </tbody></table>
    </div>
    <div class="mobile-cards">${cards}</div>`;
}

function employeeModal(emp=null){
  const e=emp||{id:'',employeeNo:String(state.meta.nextEmployeeNo),name:'',birthDate:'',email:'',phone:'',department:'',costCenter:'',manager:'',startDate:today(),endDate:'',positionTitle:'',employmentType:'Fast',salaryType:'monthly',positionPercent:100,weeklyHours:37.5,annualSalary:500000,taxRate:28,pensionRate:2,extraTax:0,vacationRate:12,status:'active',fixedItems:[],deductionPlans:[]};
  openModal(emp?'Rediger ansatt':'Ny ansatt',`
    <form id="employeeForm" class="form-grid">
      <input type="hidden" name="id" value="${esc(e.id)}">
      ${field('employeeNo','Ansattnummer',e.employeeNo,'text',true)}
      ${field('name','Navn',e.name,'text',true)}
      ${field('birthDate','Fødselsdato',e.birthDate,'date')}
      ${field('email','E-post',e.email,'email')}
      ${field('phone','Telefon',e.phone)}
      ${field('manager','Leder',e.manager)}
      ${field('department','Avdeling',e.department,'text',true)}
      ${field('costCenter','Koststed',e.costCenter,'text',true)}
      ${field('positionTitle','Stillingsnavn',e.positionTitle,'text',true)}
      ${selectField('employmentType','Ansettelsestype',e.employmentType,['Fast','Midlertidig','Vikariat','Tilkalling'])}
      ${selectField('salaryType','Lønnsform',e.salaryType,[['monthly','Månedslønn'],['hourly','Timelønn']])}
      ${field('positionPercent','Stillingsprosent',e.positionPercent,'number',true,'0.01')}
      ${selectField('weeklyHours','Ukentlig arbeidstid',String(e.weeklyHours),[['37.5','37,5 timer'],['35.5','35,5 timer']])}
      ${field('annualSalary','Årslønn i 100 %',e.annualSalary,'number',true,'1')}
      ${field('taxRate','Skatteprosent',e.taxRate,'number',true,'0.1')}
      ${field('pensionRate','Pensjonsprosent',e.pensionRate,'number',true,'0.1')}
      ${field('extraTax','Ekstra skattetrekk',e.extraTax,'number',false,'1')}
      ${field('vacationRate','Feriepengesats',e.vacationRate,'number',true,'0.1')}
      ${field('startDate','Startdato',e.startDate,'date',true)}
      ${field('endDate','Sluttdato',e.endDate,'date')}
      ${selectField('status','Status',e.status,[['active','Aktiv'],['inactive','Inaktiv']])}
      <div class="field full"><label>Faste poster</label><div id="fixedItemsEditor" class="list">${fixedItemsEditor(e.fixedItems)}</div><button type="button" class="btn small ghost" id="addFixedItem">＋ Legg til fast post</button></div>
    </form>`,
    `<button class="btn ghost" data-close-modal>Avbryt</button><button class="btn primary" id="saveEmployeeBtn">Lagre ansatt</button>`
  );
}
function fixedItemsEditor(items=[]){
  return items.map(i=>`<div class="list-item fixed-item-row" data-id="${esc(i.id)}">
    <div style="display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:8px;flex:1">
      <input class="fi-name" value="${esc(i.name)}" placeholder="Navn">
      <select class="fi-kind"><option value="earning" ${i.kind==='earning'?'selected':''}>Fast tillegg</option><option value="deduction" ${i.kind==='deduction'?'selected':''}>Fast trekk</option></select>
      <input class="fi-amount" type="number" step="0.01" value="${esc(i.amount)}" placeholder="Beløp">
    </div><button type="button" class="btn small danger remove-fixed">×</button>
  </div>`).join('');
}
function field(name,label,value,type='text',required=false,step=''){
  return `<div class="field"><label for="${name}">${esc(label)}${required?' *':''}</label><input id="${name}" name="${name}" type="${type}" value="${esc(value??'')}" ${required?'required':''} ${step?`step="${step}"`:''}></div>`;
}
function selectField(name,label,value,options){
  return `<div class="field"><label for="${name}">${esc(label)}</label><select id="${name}" name="${name}">${options.map(o=>{const val=Array.isArray(o)?o[0]:o,lab=Array.isArray(o)?o[1]:o;return `<option value="${esc(val)}" ${String(value)===String(val)?'selected':''}>${esc(lab)}</option>`}).join('')}</select></div>`;
}

function deductionPlansModal(employeeId){
  const e=employeeById(employeeId);
  if(!e) return;
  e.deductionPlans ||= [];
  const cards=e.deductionPlans.map(plan=>{
    const wt=wageTypeById(plan.wageTypeId);
    const deducted=planDeducted(plan.id);
    const remaining=planRemaining(plan);
    const frequency=plan.frequency==='once'?'Engangstrekk':`${money(plan.installmentAmount)} per måned`;
    return `<div class="plan-card">
      <div class="plan-head">
        <div><strong>${esc(wt?.code||'')} · ${esc(wt?.name||'Ukjent trekk')}</strong><small>${esc(plan.reference||'Ingen referanse')} · ${frequency}</small></div>
        ${deductionPlanBadge(plan)}
      </div>
      <div class="plan-stats">
        <div class="plan-stat"><small>Totalt krav</small><strong>${money(plan.totalAmount)}</strong></div>
        <div class="plan-stat"><small>Trukket</small><strong>${money(deducted)}</strong></div>
        <div class="plan-stat"><small>Restsaldo</small><strong>${money(remaining)}</strong></div>
      </div>
      <div class="help">Periode: ${dateText(plan.startDate)}–${plan.endDate?dateText(plan.endDate):'ingen sluttdato'}${plan.note?` · ${esc(plan.note)}`:''}</div>
      <div class="actions"><button class="btn small primary" data-edit-plan="${plan.id}">Rediger</button><button class="btn small danger" data-delete-plan="${plan.id}">Slett</button></div>
    </div>`;
  }).join('');
  openModal(`Lån og trekk · ${e.name}`,`
    <div class="notice">Her oppretter du lønnslån-avdrag, inkassotrekk, påleggstrekk og andre trekk med totalbeløp og trekkperiode.</div>
    <div class="list" style="margin-top:15px">${cards||`<div class="empty"><div class="empty-icon">−</div>Ingen aktive trekkavtaler.</div>`}</div>`,
    `<button class="btn ghost" data-close-modal>Lukk</button><button class="btn primary" id="newDeductionPlanBtn">＋ Ny trekkavtale</button>`
  );
  $('#newDeductionPlanBtn')?.addEventListener('click',()=>deductionPlanEditor(employeeId));
  $$('[data-edit-plan]').forEach(b=>b.onclick=()=>deductionPlanEditor(employeeId,e.deductionPlans.find(p=>p.id===b.dataset.editPlan)));
  $$('[data-delete-plan]').forEach(b=>b.onclick=()=>{
    const plan=e.deductionPlans.find(p=>p.id===b.dataset.deletePlan);
    if(!plan) return;
    if(planDeducted(plan.id)>0 && !confirm('Trekket har allerede historikk på lønnsslipp. Slette avtalen likevel?')) return;
    if(planDeducted(plan.id)===0 && !confirm('Slette denne trekkavtalen?')) return;
    e.deductionPlans=e.deductionPlans.filter(p=>p.id!==plan.id);
    audit(`${wageTypeById(plan.wageTypeId)?.name||'Trekkavtale'} for ${e.name} ble slettet.`,'Lønnskonsulent');
    queueSave();deductionPlansModal(employeeId);toast('Trekkavtale slettet');
  });
}
function deductionPlanEditor(employeeId,plan=null){
  const e=employeeById(employeeId);
  if(!e) return;
  const p=plan||{id:'',wageTypeId:'wt_collection',reference:'',totalAmount:0,frequency:'monthly',installmentAmount:0,startDate:today(),endDate:'',status:'active',note:''};
  const types=state.wageTypes.filter(w=>Number(w.sign)<0&&w.mode==='amount').map(w=>[w.id,`${w.code} – ${w.name}`]);
  openModal(plan?'Rediger trekkavtale':'Ny trekkavtale',`
    <form id="deductionPlanForm" class="form-grid">
      <input type="hidden" name="employeeId" value="${esc(employeeId)}">
      <input type="hidden" name="id" value="${esc(p.id)}">
      ${selectField('dpWageType','Lønnsart',p.wageTypeId,types)}
      ${field('dpReference','Referanse / saksnummer',p.reference)}
      ${field('dpTotal','Totalt skyldig beløp',p.totalAmount,'number',true,'0.01')}
      ${selectField('dpFrequency','Trekkmåte',p.frequency,[['monthly','Månedlig trekk'],['once','Engangstrekk']])}
      <div class="field" id="dpInstallmentField"><label for="dpInstallment">Beløp per måned *</label><input id="dpInstallment" name="dpInstallment" type="number" min="0" step="0.01" value="${esc(p.installmentAmount||0)}"></div>
      ${field('dpStart','Startdato',p.startDate,'date',true)}
      ${field('dpEnd','Sluttdato',p.endDate,'date')}
      ${selectField('dpStatus','Status',p.status,[['active','Aktiv'],['paused','Pauset']])}
      <div class="field full"><label for="dpNote">Kommentar</label><textarea id="dpNote" name="dpNote" placeholder="Valgfri merknad">${esc(p.note||'')}</textarea></div>
      <div class="field full"><div id="dpPreview" class="notice"></div></div>
    </form>`,
    `<button class="btn ghost" id="backToPlansBtn">Tilbake</button><button class="btn primary" id="saveDeductionPlanBtn">Lagre trekkavtale</button>`
  );
  $('#backToPlansBtn')?.addEventListener('click',()=>deductionPlansModal(employeeId));
  $('#dpFrequency')?.addEventListener('change',updateDeductionPlanPreview);
  ['dpTotal','dpInstallment','dpStart','dpEnd'].forEach(id=>$(`#${id}`)?.addEventListener('input',updateDeductionPlanPreview));
  $('#saveDeductionPlanBtn')?.addEventListener('click',saveDeductionPlan);
  updateDeductionPlanPreview();
}
function updateDeductionPlanPreview(){
  const frequency=$('#dpFrequency')?.value;
  const total=Number($('#dpTotal')?.value||0);
  const installment=Number($('#dpInstallment')?.value||0);
  const field=$('#dpInstallmentField');
  if(field) field.style.display=frequency==='once'?'none':'grid';
  const preview=$('#dpPreview');
  if(!preview) return;
  if(frequency==='once'){
    preview.innerHTML=`Hele restsaldoen på <strong>${money(total)}</strong> trekkes i første lønnskjøring innenfor perioden.`;
  }else{
    const months=installment>0?Math.ceil(total/installment):0;
    preview.innerHTML=installment>0?`Trekk: <strong>${money(installment)}</strong> per måned · omtrent <strong>${months}</strong> terminer.`:'Legg inn månedlig trekkbeløp.';
  }
}
function saveDeductionPlan(){
  const form=$('#deductionPlanForm');
  if(!form?.reportValidity()) return;
  const f=new FormData(form);
  const employeeId=f.get('employeeId'),e=employeeById(employeeId);
  if(!e) return;
  const frequency=f.get('dpFrequency');
  const total=Number(f.get('dpTotal'));
  const installment=frequency==='once'?total:Number(f.get('dpInstallment'));
  if(total<=0) return alert('Totalt skyldig beløp må være større enn 0.');
  if(frequency==='monthly'&&installment<=0) return alert('Beløp per måned må være større enn 0.');
  if(f.get('dpEnd')&&f.get('dpEnd')<f.get('dpStart')) return alert('Sluttdato kan ikke være før startdato.');
  e.deductionPlans ||= [];
  const id=f.get('id')||uid('dp');
  const old=e.deductionPlans.find(p=>p.id===id);
  const obj={id,wageTypeId:f.get('dpWageType'),reference:String(f.get('dpReference')||'').trim(),totalAmount:total,frequency,installmentAmount:installment,startDate:f.get('dpStart'),endDate:f.get('dpEnd'),status:f.get('dpStatus'),note:String(f.get('dpNote')||'').trim()};
  if(old) Object.assign(old,obj); else e.deductionPlans.push(obj);
  audit(`${wageTypeById(obj.wageTypeId)?.name||'Trekkavtale'} for ${e.name} ble ${old?'oppdatert':'opprettet'}.`,'Lønnskonsulent');
  queueSave();deductionPlansModal(employeeId);toast('Trekkavtale lagret');
}

function renderVariable(){
  const role=state.ui.role;
  const visible = state.variableEntries.slice().sort((a,b)=>b.createdAt.localeCompare(a.createdAt));
  return `
    <div class="grid cols-2">
      <div class="card">
        <div class="section-title"><div><h2>Ny registrering</h2><small>${role==='leader'?'Lederportal':'Demo-registrering'}</small></div></div>
        <form id="variableForm" class="form-grid">
          ${selectField('veEmployee','Ansatt','',state.employees.filter(e=>e.status==='active').map(e=>[e.id,`${e.employeeNo} – ${e.name}`]))}
          ${selectField('veWageType','Lønnsart','',state.wageTypes.map(w=>[w.id,`${w.code} – ${w.name}`]))}
          ${field('veDate','Dato',today(),'date',true)}
          ${field('veQuantity','Antall / timer',1,'number',true,'0.25')}
          ${field('veRate','Sats (valgfri)',0,'number',false,'0.01')}
          ${field('veAmount','Beløp (for beløpsarter)',0,'number',false,'0.01')}
          <div class="field full"><label>Kommentar / dokumentasjon</label><textarea name="veComment" placeholder="Beskriv grunnlaget for registreringen"></textarea></div>
          <div class="field full"><div id="entryPreview" class="notice">Velg lønnsart og opplysninger for å se beregnet beløp.</div></div>
          <div class="field full"><button class="btn primary" type="submit">Send til lønnskonsulent</button></div>
        </form>
      </div>
      <div class="card">
        <div class="section-title"><div><h2>Mine registreringer</h2><small>${visible.length} poster</small></div></div>
        <div class="list">
          ${visible.length?visible.map(v=>entryListItem(v,true)).join(''):`<div class="empty"><div class="empty-icon">＋</div>Ingen registreringer.</div>`}
        </div>
      </div>
    </div>`;
}
function entryListItem(v,compact=false){
  const e=employeeById(v.employeeId),w=wageTypeById(v.wageTypeId),amt=entryAmount(v);
  return `<div class="list-item">
    <div><strong>${esc(e?.name||'Ukjent')} · ${esc(w?.name||'Ukjent')}</strong><small>${dateText(v.date)} · ${Number(v.quantity||0).toLocaleString('nb-NO')} ${w?.mode==='amount'?'post':'timer'} · ${money(amt)}</small>${v.comment?`<small>${esc(v.comment)}</small>`:''}${v.reviewComment?`<small class="muted">Kommentar: ${esc(v.reviewComment)}</small>`:''}</div>
    <div class="right">${statusBadge(v.status)}${compact&&['draft','returned'].includes(v.status)?`<div style="margin-top:8px"><button class="btn small ghost" data-resubmit="${v.id}">Send på nytt</button></div>`:''}</div>
  </div>`;
}

function renderConsultant(){
  const filterOrder=['submitted','returned','approved','rejected','included'];
  const grouped=filterOrder.map(status=>[status,state.variableEntries.filter(v=>v.status===status)]).filter(([,arr])=>arr.length);
  const issues=validateEntries();
  return `
    <div class="page-actions">
      <div class="notice ${issues.length?'warning':''}">${issues.length?`${issues.length} kontrollpunkt må vurderes før lønnskjøring.`:'Ingen kritiske kontrollpunkter funnet.'}</div>
      <button class="btn ghost" data-action="approve-all">Godkjenn alle komplette</button>
    </div>
    <div class="grid cols-3">
      ${stat('Sendt inn',state.variableEntries.filter(v=>v.status==='submitted').length,'Klar til kontroll')}
      ${stat('Godkjent',state.variableEntries.filter(v=>v.status==='approved').length,'Klar til kjøring')}
      ${stat('Returnert / avvist',state.variableEntries.filter(v=>['returned','rejected'].includes(v.status)).length,'Trenger oppfølging')}
    </div>
    <div class="grid cols-2" style="margin-top:18px">
      <div class="card">
        <div class="section-title"><div><h2>Kontrollkø</h2><small>Variable lønnsposter</small></div></div>
        <div class="list">
          ${state.variableEntries.length?state.variableEntries.slice().sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).map(v=>consultantItem(v)).join(''):`<div class="empty">Køen er tom.</div>`}
        </div>
      </div>
      <div class="card">
        <div class="section-title"><div><h2>Automatiske kontroller</h2><small>${issues.length} funn</small></div></div>
        <div class="list">${issues.length?issues.map(i=>`<div class="list-item"><div><strong>${esc(i.title)}</strong><small>${esc(i.text)}</small></div><span class="badge ${i.level}">${i.level==='danger'?'Feil':'Kontroll'}</span></div>`).join(''):`<div class="empty"><div class="empty-icon">✓</div>Alt ser ryddig ut.</div>`}</div>
      </div>
    </div>`;
}
function consultantItem(v){
  const e=employeeById(v.employeeId),w=wageTypeById(v.wageTypeId);
  return `<div class="list-item" style="align-items:flex-start">
    <div><strong>${esc(e?.name||'Ukjent')} · ${esc(w?.code||'')} ${esc(w?.name||'')}</strong><small>${dateText(v.date)} · ${money(entryAmount(v))}</small><small>${esc(v.comment||'Ingen kommentar')}</small>${v.reviewComment?`<small>Tilbakemelding: ${esc(v.reviewComment)}</small>`:''}</div>
    <div class="right">${statusBadge(v.status)}
      ${v.status==='submitted'?`<div class="actions" style="margin-top:8px"><button class="btn small success" data-entry-action="approved" data-id="${v.id}">Godkjenn</button><button class="btn small ghost" data-entry-action="returned" data-id="${v.id}">Returner</button><button class="btn small danger" data-entry-action="rejected" data-id="${v.id}">Avvis</button></div>`:''}
    </div>
  </div>`;
}
function validateEntries(){
  const issues=[];
  state.variableEntries.forEach(v=>{
    const e=employeeById(v.employeeId),w=wageTypeById(v.wageTypeId),amt=entryAmount(v);
    if(!e||!w) issues.push({title:'Manglende grunndata',text:`Post ${v.id} mangler ansatt eller lønnsart.`,level:'danger'});
    if(Number(v.quantity)<0) issues.push({title:'Negativt antall',text:`${e?.name||'Ukjent'} har negativ mengde.`,level:'danger'});
    if(Math.abs(amt)>50000) issues.push({title:'Høyt beløp',text:`${e?.name||'Ukjent'}: ${money(amt)} bør kontrolleres.`,level:'warning'});
    if(w?.mode!=='amount' && Number(v.quantity)>80) issues.push({title:'Mange timer',text:`${e?.name||'Ukjent'} har ${v.quantity} timer på én post.`,level:'warning'});
    if(e?.endDate && v.date>e.endDate) issues.push({title:'Etter sluttdato',text:`Registrering for ${e.name} er etter sluttdato.`,level:'danger'});
  });
  return issues;
}

function renderRuns(){
  const run=activeRun();
  const runSlips=run?state.payslips.filter(p=>p.runId===run.id):[];
  const gross=runSlips.reduce((s,p)=>s+p.gross,0),tax=runSlips.reduce((s,p)=>s+p.tax,0),net=runSlips.reduce((s,p)=>s+p.net,0);
  return `
    <div class="page-actions">
      <div class="filters">${selectField('activeRunSelect','Velg kjøring',run?.id||'',state.runs.slice().sort((a,b)=>b.period.localeCompare(a.period)).map(r=>[r.id,`${r.name} (${statusLabel(r.status)})`]))}</div>
      <button class="btn primary" data-action="new-run">＋ Ny lønnskjøring</button>
    </div>
    ${run?`
    <div class="grid cols-4">
      ${stat('Status',statusLabel(run.status),ymText(run.period))}
      ${stat('Brutto',money(gross),`${runSlips.length} ansatte`)}
      ${stat('Skatt',money(tax),'Forenklet demo')}
      ${stat('Netto',money(net),'Simulert utbetaling')}
    </div>
    <div class="grid cols-2" style="margin-top:18px">
      <div class="card">
        <div class="section-title"><div><h2>${esc(run.name)}</h2><small>${esc(run.type)} kjøring</small></div>${statusBadge(run.status)}</div>
        <div class="notice ${run.status==='closed'?'':'warning'}">${run.status==='closed'?'Kjøringen er avsluttet og låst.':'Beregning erstatter tidligere demoresultat for denne perioden.'}</div>
        <div class="actions" style="margin-top:16px">
          <button class="btn primary" data-action="calculate-run" ${run.status==='closed'?'disabled':''}>Beregn lønn</button>
          <button class="btn ghost" data-action="set-review" ${!runSlips.length||run.status==='closed'?'disabled':''}>Sett til kontroll</button>
          <button class="btn success" data-action="close-run" ${run.status!=='review'?'disabled':''}>Godkjenn og avslutt</button>
        </div>
        <div class="list" style="margin-top:18px">
          <div class="list-item"><div><strong>Fastlønn og faste poster</strong><small>Hentes automatisk fra ansattregisteret.</small></div><span class="badge success">Automatisk</span></div>
          <div class="list-item"><div><strong>Godkjent variabel lønn</strong><small>Poster datert i ${esc(ymText(run.period))} tas med.</small></div><span class="badge">${state.variableEntries.filter(v=>['approved','included'].includes(v.status)&&inMonth(v.date,run.period)).length} poster</span></div>
          <div class="list-item"><div><strong>Lån og trekkavtaler</strong><small>Aktive månedlige trekk og engangstrekk hentes automatisk.</small></div><span class="badge">${state.employees.reduce((sum,e)=>sum+(e.deductionPlans||[]).filter(p=>planIsDue(p,run.period)).length,0)} aktive</span></div>
          <div class="list-item"><div><strong>Skatt og pensjon</strong><small>Beregnes etter prosenter på den ansatte.</small></div><span class="badge">Demo</span></div>
        </div>
      </div>
      <div class="card">
        <div class="section-title"><div><h2>Resultat per ansatt</h2><small>${runSlips.length} lønnsslipper</small></div><button class="btn small ghost" data-nav="payslips">Åpne alle</button></div>
        <div class="list">
          ${runSlips.length?runSlips.map(p=>{const e=employeeById(p.employeeId);return `<div class="list-item"><div><strong>${esc(e?.name||'Ukjent')}</strong><small>Brutto ${money(p.gross)} · Skatt ${money(p.tax)}</small></div><strong>${money(p.net)}</strong></div>`}).join(''):`<div class="empty"><div class="empty-icon">▶</div>Kjøringen er ikke beregnet.</div>`}
        </div>
      </div>
    </div>`:`<div class="card empty">Ingen lønnskjøring er valgt.</div>`}`;
}
function statusLabel(s){return ({draft:'Utkast',calculated:'Beregnet',review:'Til kontroll',closed:'Avsluttet'}[s]||s)}

function calculatePayroll(run){
  state.payslips = state.payslips.filter(p=>p.runId!==run.id);
  const activeEmployees=state.employees.filter(e=>e.status==='active' && (!e.startDate || e.startDate.slice(0,7)<=run.period) && (!e.endDate || e.endDate.slice(0,7)>=run.period));
  activeEmployees.forEach(e=>{
    const lines=[];
    const base=monthlySalary(e);
    if(base) lines.push({code:'1000',name:'Fast månedslønn',quantity:1,rate:base,amount:base,type:'earning',taxable:true,pension:true,vacation:true});
    (e.fixedItems||[]).filter(i=>i.kind==='earning').forEach(i=>lines.push({code:'1100',name:i.name,quantity:1,rate:i.amount,amount:Number(i.amount),type:'earning',taxable:true,pension:true,vacation:true}));
    const vars=state.variableEntries.filter(v=>v.employeeId===e.id && ['approved','included'].includes(v.status) && inMonth(v.date,run.period) && (!v.runId||v.runId===run.id));
    vars.forEach(v=>{
      const w=wageTypeById(v.wageTypeId),a=entryAmount(v);
      if(!w) return;
      lines.push({code:w.code,name:w.name,quantity:Number(v.quantity||1),rate:w.mode==='amount'?Math.abs(a):(a/(Number(v.quantity)||1)),amount:a,type:a>=0?'earning':'deduction',taxable:w.taxable,pension:w.pension,vacation:w.vacation,sourceEntryId:v.id});
      v.status='included'; v.runId=run.id;
    });

    const scheduledDeductions=[];
    (e.deductionPlans||[]).forEach(plan=>{
      if(!planIsDue(plan,run.period)) return;
      const wt=wageTypeById(plan.wageTypeId);
      if(!wt) return;
      const remaining=planRemaining(plan);
      const amount=Math.min(remaining,plan.frequency==='once'?remaining:Number(plan.installmentAmount||0));
      if(amount<=0) return;
      const line={code:wt.code,name:wt.name,quantity:1,rate:amount,amount:-amount,type:'deduction',taxable:false,pension:false,vacation:false,sourcePlanId:plan.id,planReference:plan.reference||'',planRemainingAfter:Math.max(0,remaining-amount)};
      scheduledDeductions.push(line);
      lines.push(line);
    });

    const gross=lines.filter(l=>l.type==='earning').reduce((s,l)=>s+l.amount,0)+lines.filter(l=>l.type==='deduction'&&l.taxable).reduce((s,l)=>s+l.amount,0);
    const pensionBase=lines.filter(l=>l.pension).reduce((s,l)=>s+l.amount,0);
    const pension=Math.max(0,pensionBase*Number(e.pensionRate||0)/100);
    const taxBase=Math.max(0,lines.filter(l=>l.taxable).reduce((s,l)=>s+l.amount,0)-pension);
    const tax=Math.max(0,taxBase*Number(e.taxRate||0)/100+Number(e.extraTax||0));

    const fixedDeductionAmount=fixedDeductions(e);
    (e.fixedItems||[]).filter(i=>i.kind==='deduction').forEach(i=>lines.push({code:fixedDeductionCode(i),name:i.name,quantity:1,rate:i.amount,amount:-Number(i.amount),type:'deduction',taxable:false,pension:false,vacation:false}));
    const scheduledDeductionAmount=scheduledDeductions.reduce((s,l)=>s+Math.abs(l.amount),0);
    const variableNonTaxableDeductionAmount=lines.filter(l=>l.sourceEntryId&&l.type==='deduction'&&!l.taxable).reduce((s,l)=>s+Math.abs(Number(l.amount||0)),0);
    const other=fixedDeductionAmount+scheduledDeductionAmount+variableNonTaxableDeductionAmount;

    lines.push({code:'7000',name:`Pensjon ${e.pensionRate}%`,quantity:1,rate:pension,amount:-pension,type:'deduction'});
    lines.push({code:'7100',name:`Skattetrekk ${e.taxRate}%`,quantity:1,rate:tax,amount:-tax,type:'deduction'});
    const net=gross-pension-tax-other;
    const vacationBase=lines.filter(l=>l.vacation).reduce((s,l)=>s+l.amount,0);
    state.payslips.push({id:uid('slip'),runId:run.id,employeeId:e.id,period:run.period,lines,gross,pension,tax,otherDeductions:other,scheduledDeductions:scheduledDeductionAmount,net,vacationBase,vacationAccrued:vacationBase*Number(e.vacationRate||0)/100,createdAt:new Date().toISOString()});
  });
  run.status='calculated'; run.calculatedAt=new Date().toISOString();
  audit(`${run.name} ble beregnet for ${activeEmployees.length} ansatte.`,'Lønnskonsulent');
  queueSave();
}

function renderPayslips(){
  const selectedRun=activeRun();
  const slips=selectedRun?state.payslips.filter(p=>p.runId===selectedRun.id):[];
  const selectedId=state.ui.selectedEmployeeId;
  const selected=slips.find(p=>p.employeeId===selectedId)||slips[0];
  if(selected) state.ui.selectedEmployeeId=selected.employeeId;
  return `
    <div class="page-actions no-print">
      <div class="filters">
        <select id="payslipEmployeeSelect">${slips.map(p=>{const e=employeeById(p.employeeId);return `<option value="${p.employeeId}" ${selected?.employeeId===p.employeeId?'selected':''}>${esc(e?.employeeNo||'')} – ${esc(e?.name||'Ukjent')}</option>`}).join('')}</select>
      </div>
      <button class="btn primary" data-action="print">Skriv ut / lagre PDF</button>
    </div>
    ${selected?payslipHtml(selected):`<div class="card empty"><div class="empty-icon">▤</div>Beregn en lønnskjøring først.</div>`}`;
}
function payslipHtml(p){
  const e=employeeById(p.employeeId),r=runById(p.runId);
  return `<div class="payslip">
    <div class="payslip-head"><div><h2 style="margin:0">Lønnsslipp</h2><p style="margin:6px 0 0">${esc(state.meta.company)}</p><small>Org.nr. ${esc(state.meta.orgNo)}</small></div><div class="right"><strong>${esc(ymText(p.period))}</strong><small style="display:block">Kjøring: ${esc(r?.name||'')}</small></div></div>
    <div class="payslip-grid">
      <div><strong>${esc(e?.name||'')}</strong><small style="display:block">Ansattnummer ${esc(e?.employeeNo||'')}</small><small style="display:block">${esc(e?.positionTitle||'')}</small></div>
      <div><strong>Arbeidsforhold</strong><small style="display:block">${esc(e?.department||'')} / ${esc(e?.costCenter||'')}</small><small style="display:block">${esc(e?.positionPercent||0)} % · ${esc(e?.weeklyHours||0)} t/uke</small></div>
    </div>
    <div class="table-wrap"><table><thead><tr><th>Lønnsart</th><th>Beskrivelse</th><th class="money">Antall</th><th class="money">Sats</th><th class="money">Beløp</th></tr></thead><tbody>
      ${p.lines.map(l=>`<tr><td>${esc(l.code)}</td><td>${esc(l.name)}</td><td class="money">${Number(l.quantity||0).toLocaleString('nb-NO')}</td><td class="money">${money(l.rate)}</td><td class="money">${money(l.amount)}</td></tr>`).join('')}
    </tbody></table></div>
    <div class="totals" style="margin-top:18px">
      <div class="total-row"><span>Bruttolønn</span><strong>${money(p.gross)}</strong></div>
      <div class="total-row"><span>Pensjon</span><strong>− ${money(p.pension)}</strong></div>
      <div class="total-row"><span>Skattetrekk</span><strong>− ${money(p.tax)}</strong></div>
      <div class="total-row"><span>Andre trekk</span><strong>− ${money(p.otherDeductions)}</strong></div>
      <div class="total-row net"><span>Netto</span><span>${money(p.net)}</span></div>
    </div>
    <div class="notice" style="margin-top:22px">Feriepengegrunnlag denne perioden: <strong>${money(p.vacationBase)}</strong> · Opptjent feriepenger: <strong>${money(p.vacationAccrued)}</strong></div>
    <p class="help" style="margin-top:18px">Dette er en simulert lønnsslipp produsert av Lønnssystem Demo. Ingen betaling eller myndighetsrapportering er gjennomført.</p>
  </div>`;
}

function renderReports(){
  const run=activeRun(),slips=run?state.payslips.filter(p=>p.runId===run.id):[];
  const tabs=[['journal','Detaljert lønnsjournal'],['department','Avdeling'],['deductions','Trekk'],['agreements','Trekkavtaler'],['wagetypes','Lønnsarter']];
  return `
    <div class="toolbar">
      <div class="segmented">${tabs.map(t=>`<button data-report="${t[0]}" class="${reportType===t[0]?'active':''}">${t[1]}</button>`).join('')}</div>
      <div class="actions"><button class="btn ghost" data-action="export-report">Eksporter CSV</button><button class="btn primary" data-action="print">Skriv ut / PDF</button></div>
    </div>
    <div class="card">
      <div class="section-title"><div><h2>${tabs.find(t=>t[0]===reportType)?.[1]}</h2><small>${reportType==='agreements'?'Alle ansatte og aktive historiske avtaler':run?esc(run.name):'Ingen aktiv kjøring'}</small></div></div>
      ${reportTable(reportType,slips)}
    </div>`;
}
function reportTable(type,slips){
  if(type==='agreements'){
    const rows=state.employees.flatMap(e=>(e.deductionPlans||[]).map(plan=>({employee:e,plan,wt:wageTypeById(plan.wageTypeId)})));
    if(!rows.length) return `<div class="empty">Ingen trekkavtaler er opprettet.</div>`;
    return `<div class="table-wrap"><table><thead><tr><th>Ansatt</th><th>Lønnskode</th><th>Trekkart</th><th>Referanse</th><th>Trekkmåte</th><th>Periode</th><th class="money">Totalt</th><th class="money">Trukket</th><th class="money">Restsaldo</th><th>Status</th></tr></thead><tbody>${rows.map(({employee:e,plan,wt})=>`<tr><td>${esc(e.employeeNo)} – ${esc(e.name)}</td><td><strong>${esc(wt?.code||'')}</strong></td><td>${esc(wt?.name||'')}</td><td>${esc(plan.reference||'–')}</td><td>${plan.frequency==='once'?'Engang':`${money(plan.installmentAmount)} / mnd.`}</td><td>${dateText(plan.startDate)}–${plan.endDate?dateText(plan.endDate):'åpen'}</td><td class="money">${money(plan.totalAmount)}</td><td class="money">${money(planDeducted(plan.id))}</td><td class="money"><strong>${money(planRemaining(plan))}</strong></td><td>${deductionPlanBadge(plan)}</td></tr>`).join('')}</tbody></table></div>`;
  }
  if(!slips.length) return `<div class="empty">Ingen beregnede data i valgt kjøring.</div>`;
  if(type==='journal'){
    const rows=slips.flatMap(p=>{
      const e=employeeById(p.employeeId);
      return p.lines.map(l=>({employee:e,line:l}));
    });
    const total=rows.reduce((sum,row)=>sum+Number(row.line.amount||0),0);
    return `<div class="table-wrap"><table><thead><tr><th>Ansattnr.</th><th>Ansatt</th><th>Avdeling</th><th>Lønnskode</th><th>Lønnsart</th><th class="money">Antall</th><th class="money">Sats</th><th class="money">Beløp</th></tr></thead><tbody>${rows.map(({employee:e,line:l})=>`<tr><td>${esc(e?.employeeNo||'')}</td><td>${esc(e?.name||'')}</td><td>${esc(e?.department||'')}</td><td><strong>${esc(l.code||'')}</strong></td><td>${esc(l.name||'')}${l.planReference?`<small class="muted">${esc(l.planReference)}</small>`:''}</td><td class="money">${Number(l.quantity||0).toLocaleString('nb-NO')}</td><td class="money">${money(l.rate)}</td><td class="money">${money(l.amount)}</td></tr>`).join('')}<tr><td colspan="7"><strong>Sum alle rapportlinjer</strong></td><td class="money"><strong>${money(total)}</strong></td></tr></tbody></table></div>`;
  }
  if(type==='department'){
    const groups={};slips.forEach(p=>{const e=employeeById(p.employeeId),k=e?.department||'Ukjent';groups[k]??={count:0,gross:0,tax:0,net:0};groups[k].count++;groups[k].gross+=p.gross;groups[k].tax+=p.tax;groups[k].net+=p.net});
    return `<div class="table-wrap"><table><thead><tr><th>Avdeling</th><th>Ansatte</th><th class="money">Brutto</th><th class="money">Skatt</th><th class="money">Netto</th></tr></thead><tbody>${Object.entries(groups).map(([k,g])=>`<tr><td>${esc(k)}</td><td>${g.count}</td><td class="money">${money(g.gross)}</td><td class="money">${money(g.tax)}</td><td class="money">${money(g.net)}</td></tr>`).join('')}</tbody></table></div>`;
  }
  if(type==='deductions'){
    const rows=slips.flatMap(p=>{
      const e=employeeById(p.employeeId);
      return (p.lines||[]).filter(l=>Number(l.amount)<0).map(l=>({employee:e,line:l}));
    });
    const total=rows.reduce((s,row)=>s+Math.abs(Number(row.line.amount||0)),0);
    return `<div class="table-wrap"><table><thead><tr><th>Ansatt</th><th>Lønnskode</th><th>Trekkart</th><th>Referanse</th><th class="money">Beløp</th></tr></thead><tbody>${rows.map(({employee:e,line:l})=>`<tr><td>${esc(e?.employeeNo||'')} – ${esc(e?.name||'')}</td><td><strong>${esc(l.code||'')}</strong></td><td>${esc(l.name||'')}</td><td>${esc(l.planReference||'–')}</td><td class="money">${money(Math.abs(l.amount))}</td></tr>`).join('')}<tr><td colspan="4"><strong>Sum trekk</strong></td><td class="money"><strong>${money(total)}</strong></td></tr></tbody></table></div>`;
  }
  const groups={};slips.forEach(p=>p.lines.forEach(l=>{groups[l.code]??={name:l.name,amount:0,count:0};groups[l.code].amount+=l.amount;groups[l.code].count++}));
  return `<div class="table-wrap"><table><thead><tr><th>Lønnskode</th><th>Lønnsart</th><th>Linjer</th><th class="money">Beløp</th></tr></thead><tbody>${Object.entries(groups).sort().map(([code,g])=>`<tr><td><strong>${esc(code)}</strong></td><td>${esc(g.name)}</td><td>${g.count}</td><td class="money">${money(g.amount)}</td></tr>`).join('')}</tbody></table></div>`;
}

function renderSettings(){
  return `
    <div class="grid cols-2">
      <div class="card">
        <div class="section-title"><div><h2>Lønnsarter</h2><small>${state.wageTypes.length} aktive definisjoner</small></div><button class="btn small primary" data-action="new-wagetype">＋ Ny</button></div>
        <div class="list">${state.wageTypes.map(w=>`<div class="list-item"><div><strong>${esc(w.code)} · ${esc(w.name)}</strong><small>${esc(w.category)} · ${w.mode==='amount'?'Beløp':w.mode==='hours'?`Fast sats ${money(w.rate)}`:w.mode==='overtime'?`${w.multiplier*100}% av timesats`:'Timesats'}</small></div><button class="btn small ghost" data-edit-wagetype="${w.id}">Rediger</button></div>`).join('')}</div>
      </div>
      <div class="grid">
        <div class="card">
          <div class="section-title"><h2>Data og backup</h2></div>
          <p class="muted">Data lagres i IndexedDB i denne nettleseren. Eksporter en backup før du tømmer Safari-data eller bytter enhet.</p>
          <div class="actions"><button class="btn primary" data-action="export-backup">Eksporter backup</button><button class="btn ghost" data-action="import-backup">Importer</button><button class="btn danger" data-action="reset-demo">Nullstill demo</button></div>
        </div>
        <div class="card">
          <div class="section-title"><h2>Virksomhet</h2></div>
          <form id="companyForm" class="form-grid">
            ${field('companyName','Navn',state.meta.company,'text',true)}
            ${field('companyOrg','Organisasjonsnummer',state.meta.orgNo)}
            <div class="field full"><button class="btn primary">Lagre oppsett</button></div>
          </form>
        </div>
        <div class="card">
          <div class="section-title"><h2>Teknisk status</h2></div>
          <div class="list">
            <div class="list-item"><div><strong>Lokalt datalager</strong><small>IndexedDB med localStorage-reserve</small></div><span class="badge success">Aktiv</span></div>
            <div class="list-item"><div><strong>Installerbar app</strong><small>Manifest og service worker</small></div><span class="badge success">Klar</span></div>
            <div class="list-item"><div><strong>Eksterne integrasjoner</strong><small>Bank, Altinn og UBW</small></div><span class="badge">Deaktivert</span></div>
          </div>
        </div>
      </div>
    </div>`;
}

function wageTypeModal(w=null){
  const x=w||{id:'',code:'',name:'',mode:'hours',rate:0,multiplier:1,sign:1,taxable:true,pension:true,vacation:true,category:'Tillegg'};
  openModal(w?'Rediger lønnsart':'Ny lønnsart',`
    <form id="wageTypeForm" class="form-grid">
      <input type="hidden" name="id" value="${esc(x.id)}">
      ${field('code','Kode',x.code,'text',true)}
      ${field('name','Navn',x.name,'text',true)}
      ${selectField('category','Kategori',x.category,['Tillegg','Overtid','Timer','Trekk','Refusjon','Lønnslån','Korreksjon'])}
      ${selectField('mode','Beregning',x.mode,[['amount','Beløp'],['hours','Timer × fast sats'],['hourly','Timer × ansattsats'],['overtime','Timer × overtidsfaktor']])}
      ${field('rate','Fast sats',x.rate,'number',false,'0.01')}
      ${field('multiplier','Faktor',x.multiplier,'number',false,'0.1')}
      ${selectField('sign','Fortegn',String(x.sign),[['1','Tillegg (+)'],['-1','Trekk (−)']])}
      <div class="field full"><label class="inline-check"><input type="checkbox" name="taxable" ${x.taxable?'checked':''}> Skattepliktig</label><label class="inline-check"><input type="checkbox" name="pension" ${x.pension?'checked':''}> Pensjonsgivende</label><label class="inline-check"><input type="checkbox" name="vacation" ${x.vacation?'checked':''}> Feriepengegrunnlag</label></div>
    </form>`,
    `<button class="btn ghost" data-close-modal>Avbryt</button><button class="btn primary" id="saveWageTypeBtn">Lagre lønnsart</button>`
  );
}

function bindViewEvents(){
  $$('[data-nav]').forEach(b=>b.onclick=()=>setView(b.dataset.nav));
  $('#employeeSearch')?.addEventListener('input',e=>{$$('.employee-row').forEach(r=>r.style.display=r.dataset.search.includes(e.target.value.toLowerCase())?'':'none')});
  $$('[data-edit-employee]').forEach(b=>b.onclick=()=>employeeModal(employeeById(b.dataset.editEmployee)));
  $$('[data-deduction-plans]').forEach(b=>b.onclick=()=>deductionPlansModal(b.dataset.deductionPlans));
  $$('[data-employee-payslip]').forEach(b=>b.onclick=()=>{state.ui.selectedEmployeeId=b.dataset.employeePayslip;setView('payslips')});
  $('[data-action="new-employee"]')?.addEventListener('click',()=>employeeModal());
  $('#variableForm')?.addEventListener('submit',submitVariable);
  ['veEmployee','veWageType','veQuantity','veRate','veAmount'].forEach(id=>$(`#${id}`)?.addEventListener('input',updateEntryPreview));
  $$('[data-resubmit]').forEach(b=>b.onclick=()=>{const v=state.variableEntries.find(x=>x.id===b.dataset.resubmit);if(v){v.status='submitted';v.reviewComment='';audit(`Post for ${employeeById(v.employeeId)?.name} ble sendt inn på nytt.`,'Leder');queueSave();render();}});
  $$('[data-entry-action]').forEach(b=>b.onclick=()=>reviewEntry(b.dataset.id,b.dataset.entryAction));
  $('[data-action="approve-all"]')?.addEventListener('click',()=>{state.variableEntries.filter(v=>v.status==='submitted').forEach(v=>v.status='approved');audit('Alle komplette variable poster ble godkjent.','Lønnskonsulent');queueSave();render();toast('Poster godkjent')});
  $('#activeRunSelect')?.addEventListener('change',e=>{const chosen=runById(e.target.value);state.runs.forEach(r=>r._selected=false);if(chosen)chosen._selected=true;const idx=state.runs.indexOf(chosen);if(idx>0){state.runs.splice(idx,1);state.runs.unshift(chosen)}queueSave();render()});
  $('[data-action="new-run"]')?.addEventListener('click',newRunModal);
  $('[data-action="calculate-run"]')?.addEventListener('click',()=>{const r=activeRun();if(r){calculatePayroll(r);render();toast('Lønn er beregnet')}});
  $('[data-action="quick-run"]')?.addEventListener('click',()=>{const r=activeRun();if(r&&r.status!=='closed'){calculatePayroll(r);setView('runs')}else toast('Ingen åpen lønnskjøring')});
  $('[data-action="set-review"]')?.addEventListener('click',()=>{const r=activeRun();r.status='review';audit(`${r.name} ble satt til kontroll.`,'Lønnskonsulent');queueSave();render()});
  $('[data-action="close-run"]')?.addEventListener('click',()=>{const r=activeRun();r.status='closed';r.closedAt=new Date().toISOString();audit(`${r.name} ble godkjent og avsluttet.`,'Lønnskonsulent');queueSave();render();toast('Kjøringen er avsluttet')});
  $('#payslipEmployeeSelect')?.addEventListener('change',e=>{state.ui.selectedEmployeeId=e.target.value;queueSave();render()});
  $$('[data-report]').forEach(b=>b.onclick=()=>{reportType=b.dataset.report;render()});
  $('[data-action="export-report"]')?.addEventListener('click',exportReport);
  $$('[data-action="print"]').forEach(b=>b.onclick=()=>window.print());
  $('[data-action="new-wagetype"]')?.addEventListener('click',()=>wageTypeModal());
  $$('[data-edit-wagetype]').forEach(b=>b.onclick=()=>wageTypeModal(wageTypeById(b.dataset.editWagetype)));
  $('[data-action="export-backup"]')?.addEventListener('click',exportBackup);
  $('[data-action="import-backup"]')?.addEventListener('click',()=>$('#importInput').click());
  $('[data-action="reset-demo"]')?.addEventListener('click',resetDemo);
  $('#companyForm')?.addEventListener('submit',e=>{e.preventDefault();state.meta.company=e.target.companyName.value.trim();state.meta.orgNo=e.target.companyOrg.value.trim();queueSave();toast('Oppsett lagret')});
}
function submitVariable(e){
  e.preventDefault();const f=new FormData(e.target);
  const v={id:uid('ve'),employeeId:f.get('veEmployee'),wageTypeId:f.get('veWageType'),date:f.get('veDate'),quantity:Number(f.get('veQuantity')),rate:Number(f.get('veRate')),amount:Number(f.get('veAmount')),comment:String(f.get('veComment')||'').trim(),status:'submitted',createdBy:state.ui.role==='leader'?'Demo-leder':'Demo-bruker',createdAt:new Date().toISOString()};
  state.variableEntries.unshift(v);audit(`Variabel lønn for ${employeeById(v.employeeId)?.name} ble sendt inn.`,'Leder');queueSave();e.target.reset();render();toast('Registreringen er sendt inn');
}
function updateEntryPreview(){
  const fake={employeeId:$('#veEmployee')?.value,wageTypeId:$('#veWageType')?.value,quantity:Number($('#veQuantity')?.value),rate:Number($('#veRate')?.value),amount:Number($('#veAmount')?.value)};
  const wt=wageTypeById(fake.wageTypeId),el=$('#entryPreview');
  if(el&&wt) el.innerHTML=`Beregnet beløp: <strong>${money(entryAmount(fake))}</strong> · ${esc(wt.name)}`;
}
function reviewEntry(id,action){
  const v=state.variableEntries.find(x=>x.id===id);if(!v)return;
  let comment='';
  if(['returned','rejected'].includes(action)) comment=prompt(action==='returned'?'Hva må korrigeres?':'Begrunn avvisningen:')||'Ingen kommentar.';
  v.status=action;v.reviewComment=comment;v.reviewedAt=new Date().toISOString();
  audit(`${wageTypeById(v.wageTypeId)?.name} for ${employeeById(v.employeeId)?.name} ble ${action==='approved'?'godkjent':action==='returned'?'returnert':'avvist'}.`,'Lønnskonsulent');
  queueSave();render();toast('Status oppdatert');
}
function newRunModal(){
  openModal('Ny lønnskjøring',`<form id="runForm" class="form-grid">${field('runName','Navn',`Ordinær lønn ${ymText(monthNow())}`,'text',true)}${field('runPeriod','Periode',monthNow(),'month',true)}${selectField('runType','Type','Ordinær',['Ordinær','Ekstra','Korreksjon','Feriepenger','Etterbetaling'])}</form>`,`<button class="btn ghost" data-close-modal>Avbryt</button><button class="btn primary" id="saveRunBtn">Opprett</button>`);
}
function openModal(title,body,footer=''){
  $('#modalHost').innerHTML=`<div class="modal-backdrop"><div class="modal"><div class="modal-header"><h2 style="margin:0">${esc(title)}</h2><button class="icon-btn" data-close-modal>×</button></div><div class="modal-body">${body}</div>${footer?`<div class="modal-footer">${footer}</div>`:''}</div></div>`;
  $$('[data-close-modal]').forEach(b=>b.onclick=closeModal);
  $('#addFixedItem')?.addEventListener('click',()=>{const wrap=$('#fixedItemsEditor');wrap.insertAdjacentHTML('beforeend',fixedItemsEditor([{id:uid('fi'),name:'',amount:0,kind:'earning'}]));bindFixedRemove()});
  bindFixedRemove();
  $('#saveEmployeeBtn')?.addEventListener('click',saveEmployee);
  $('#saveRunBtn')?.addEventListener('click',saveRun);
  $('#saveWageTypeBtn')?.addEventListener('click',saveWageType);
}
function closeModal(){$('#modalHost').innerHTML=''}
function bindFixedRemove(){$$('.remove-fixed').forEach(b=>b.onclick=()=>b.closest('.fixed-item-row').remove())}
function saveEmployee(){
  const form=$('#employeeForm');if(!form.reportValidity())return;
  const f=new FormData(form),id=f.get('id')||uid('emp');
  const old=employeeById(id);
  const fixedItems=$$('.fixed-item-row').map(r=>({id:r.dataset.id||uid('fi'),name:$('.fi-name',r).value.trim(),kind:$('.fi-kind',r).value,amount:Number($('.fi-amount',r).value)})).filter(i=>i.name);
  const obj={id,employeeNo:String(f.get('employeeNo')).trim(),name:String(f.get('name')).trim(),birthDate:f.get('birthDate'),email:String(f.get('email')||'').trim(),phone:String(f.get('phone')||'').trim(),department:String(f.get('department')).trim(),costCenter:String(f.get('costCenter')).trim(),manager:String(f.get('manager')||'').trim(),startDate:f.get('startDate'),endDate:f.get('endDate'),positionTitle:String(f.get('positionTitle')).trim(),employmentType:f.get('employmentType'),salaryType:f.get('salaryType'),positionPercent:Number(f.get('positionPercent')),weeklyHours:Number(f.get('weeklyHours')),annualSalary:Number(f.get('annualSalary')),taxRate:Number(f.get('taxRate')),pensionRate:Number(f.get('pensionRate')),extraTax:Number(f.get('extraTax')),vacationRate:Number(f.get('vacationRate')),status:f.get('status'),fixedItems,deductionPlans:old?.deductionPlans||[]};
  if(old) Object.assign(old,obj); else {state.employees.push(obj);state.meta.nextEmployeeNo=Math.max(state.meta.nextEmployeeNo,Number(obj.employeeNo)+1)}
  audit(`${obj.name} ble ${old?'oppdatert':'opprettet'} i ansattregisteret.`,'Systemadministrator');queueSave();closeModal();render();toast('Ansatt lagret');
}
function saveRun(){
  const form=$('#runForm');if(!form.reportValidity())return;const f=new FormData(form);
  const run={id:uid('run'),name:String(f.get('runName')).trim(),period:f.get('runPeriod'),type:f.get('runType'),status:'draft',createdAt:new Date().toISOString()};
  state.runs.unshift(run);audit(`${run.name} ble opprettet.`,'Lønnskonsulent');queueSave();closeModal();render();toast('Lønnskjøring opprettet');
}
function saveWageType(){
  const form=$('#wageTypeForm');if(!form.reportValidity())return;const f=new FormData(form),id=f.get('id')||uid('wt'),old=wageTypeById(id);
  const obj={id,code:String(f.get('code')).trim(),name:String(f.get('name')).trim(),category:f.get('category'),mode:f.get('mode'),rate:Number(f.get('rate')),multiplier:Number(f.get('multiplier')),sign:Number(f.get('sign')),taxable:f.has('taxable'),pension:f.has('pension'),vacation:f.has('vacation')};
  if(old)Object.assign(old,obj);else state.wageTypes.push(obj);
  audit(`Lønnsart ${obj.code} ${obj.name} ble lagret.`,'Systemadministrator');queueSave();closeModal();render();toast('Lønnsart lagret');
}
function exportBackup(){downloadFile(`lonnsdemo-backup-${today()}.json`,JSON.stringify(state,null,2),'application/json')}
function exportReport(){
  const run=activeRun(),slips=run?state.payslips.filter(p=>p.runId===run.id):[];
  if(reportType!=='agreements'&&!slips.length) return toast('Ingen rapportdata');
  let rows=[];
  let fileName=`rapport-${reportType}-${run?.period||today()}.csv`;
  if(reportType==='journal'){
    rows=[['Ansattnummer','Navn','Avdeling','Lønnskode','Lønnsart','Referanse','Antall','Sats','Beløp']];
    slips.forEach(p=>{
      const e=employeeById(p.employeeId);
      p.lines.forEach(l=>rows.push([e?.employeeNo,e?.name,e?.department,l.code,l.name,l.planReference||'',l.quantity,l.rate,l.amount]));
    });
    fileName=`detaljert-lonnsjournal-${run.period}.csv`;
  }else if(reportType==='department'){
    rows=[['Avdeling','Antall ansatte','Brutto','Skatt','Netto']];
    const groups={};
    slips.forEach(p=>{const e=employeeById(p.employeeId),k=e?.department||'Ukjent';groups[k]??={count:0,gross:0,tax:0,net:0};groups[k].count++;groups[k].gross+=p.gross;groups[k].tax+=p.tax;groups[k].net+=p.net});
    Object.entries(groups).forEach(([name,g])=>rows.push([name,g.count,g.gross,g.tax,g.net]));
  }else if(reportType==='deductions'){
    rows=[['Ansattnummer','Navn','Lønnskode','Trekkart','Referanse','Beløp']];
    slips.forEach(p=>{
      const e=employeeById(p.employeeId);
      (p.lines||[]).filter(l=>Number(l.amount)<0).forEach(l=>rows.push([e?.employeeNo,e?.name,l.code,l.name,l.planReference||'',Math.abs(l.amount)]));
    });
  }else if(reportType==='agreements'){
    rows=[['Ansattnummer','Navn','Lønnskode','Trekkart','Referanse','Trekkmåte','Beløp per måned','Startdato','Sluttdato','Totalt krav','Trukket','Restsaldo','Status']];
    state.employees.forEach(e=>(e.deductionPlans||[]).forEach(plan=>{
      const wt=wageTypeById(plan.wageTypeId);
      rows.push([e.employeeNo,e.name,wt?.code||'',wt?.name||'',plan.reference||'',plan.frequency==='once'?'Engang':'Månedlig',plan.frequency==='monthly'?plan.installmentAmount:'',plan.startDate,plan.endDate,plan.totalAmount,planDeducted(plan.id),planRemaining(plan),deductionPlanStatus(plan)[0]]);
    }));
    fileName=`trekkavtaler-${today()}.csv`;
  }else{
    rows=[['Lønnskode','Lønnsart','Antall linjer','Beløp']];
    const groups={};
    slips.forEach(p=>p.lines.forEach(l=>{groups[l.code]??={name:l.name,amount:0,count:0};groups[l.code].amount+=l.amount;groups[l.code].count++}));
    Object.entries(groups).sort().forEach(([code,g])=>rows.push([code,g.name,g.count,g.amount]));
  }
  const csv=rows.map(r=>r.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(';')).join('\n');
  downloadFile(fileName, '\ufeff'+csv,'text/csv;charset=utf-8');
}

function downloadFile(name,content,type){
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([content],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
async function resetDemo(){
  if(!confirm('Dette sletter alle lokale endringer og gjenoppretter demo-data. Fortsette?'))return;
  state=defaultState();await persistState();render();toast('Demoen er nullstilt');
}

document.addEventListener('click',e=>{
  if(e.target.classList.contains('modal-backdrop'))closeModal();
});
$('#mainNav').addEventListener('click',e=>{const b=e.target.closest('[data-view]');if(b)setView(b.dataset.view)});
$('#mobileMenuBtn').addEventListener('click',()=>$('.sidebar').classList.toggle('open'));
$('#roleSelect').addEventListener('change',e=>{state.ui.role=e.target.value;queueSave();toast(`Rolle: ${e.target.options[e.target.selectedIndex].text}`);render()});
$('#themeBtn').addEventListener('click',()=>{state.ui.theme=state.ui.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=state.ui.theme;queueSave()});
$('#importInput').addEventListener('change',async e=>{
  const file=e.target.files[0];if(!file)return;
  try{const imported=JSON.parse(await file.text());if(!imported.employees||!imported.wageTypes)throw new Error('Ugyldig fil');state=imported;migrateState();await persistState();document.documentElement.dataset.theme=state.ui?.theme||'light';render();toast('Backup importert')}catch(err){alert('Kunne ikke importere backup: '+err.message)}finally{e.target.value=''}
});

(async function init(){
  state=await loadState()||defaultState();
  migrateState();
  state.ui ||= {theme:'light',role:'admin',selectedEmployeeId:''};
  document.documentElement.dataset.theme=state.ui.theme||'light';
  $('#roleSelect').value=state.ui.role||'admin';
  render();
  if('serviceWorker' in navigator){
    window.addEventListener('load',()=>navigator.serviceWorker.register('./service-worker.js').catch(console.warn));
  }
})();

  </script>
</body>
</html>
